# Nx Assistant — set these in Vercel: Project → Settings → Environment Variables.
# NEVER commit real values to the repo.

# Required — the assistant cannot answer without it (needs credit balance).
ANTHROPIC_API_KEY=sk-ant-...

# Conversation + lead storage (Supabase project → Settings → API).
# Optional: chat works without it, but nothing is persisted.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Lead notifications (Slack → incoming webhook for #website-leads).
# Optional: leads still go to Supabase without it.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Booking link shared by the assistant (defaults to this value if unset).
CALENDLY_URL=https://calendly.com/ravi-nxgp

# Model override (defaults to claude-haiku-4-5-20251001).
# ASSISTANT_MODEL=claude-sonnet-5

# Learning pass (/api/learn) — any long random string. Without it the
# endpoint refuses all requests.
LEARN_SECRET=

# Model used to mine insights (defaults to claude-haiku-4-5-20251001).
# LEARN_MODEL=claude-sonnet-5

# Vercel Cron auth for the daily learning pass (vercel.json). Set this and
# Vercel automatically sends it as Authorization: Bearer on cron requests.
CRON_SECRET=

# Global daily message cap across all IPs (default 2000) — bounds worst-case
# Anthropic spend against distributed scrapers.
# ASSISTANT_DAILY_CAP=2000

# Days to keep raw chat transcripts before the learning pass purges them
# (default 90; 0 disables). Lead conversations keep their metadata + lead.
# RETENTION_DAYS=90
