{
  "name": "nxgp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-contentful.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:chat": "node scripts/test-chat-e2e.mjs",
    "eval": "node scripts/eval-assistant.mjs",
    "blog:fetch": "node scripts/fetch-contentful.mjs",
    "blog:preview": "CONTENTFUL_PREVIEW=1 node scripts/fetch-contentful.mjs"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "@contentful/rich-text-types": "^17.2.7",
    "contentful": "^11.12.9",
    "gsap": "^3.15.0",
    "lenis": "^1.3.24",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
